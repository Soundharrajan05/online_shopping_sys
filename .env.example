# ============================================================
# Environment Configuration – Online Shopping System
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.

# --------------------------------------------------------
# Flask Configuration
# --------------------------------------------------------
# A long, random, secret string used to sign session cookies.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here-change-this

# Set to "production" on Vercel, "development" locally.
FLASK_CONFIG=development

# --------------------------------------------------------
# MySQL Database – Vercel Deployment
# --------------------------------------------------------
# Provide DATABASE_URL for cloud/Vercel deployment.
# Format: mysql://username:password@host:3306/database_name
#
# Examples:
#   PlanetScale:  mysql://user:pass@host.aws.connect.psdb.cloud/shopping_system?ssl-mode=VERIFY_IDENTITY
#   Aiven:        mysql://user:pass@host.aivencloud.com:PORT/shopping_system?ssl-mode=REQUIRED
#   Local:        mysql://root:password@localhost:3306/shopping_system
DATABASE_URL=mysql://username:password@host:3306/shopping_system

# --------------------------------------------------------
# MySQL Database – Local / Individual Variables
# --------------------------------------------------------
# Used automatically when DATABASE_URL is NOT set.
# Useful for local development without a connection string.
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=shopping_system
DB_PORT=3306
